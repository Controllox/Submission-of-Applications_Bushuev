<Page x:Class="Submission_of_Applications_Bushuev.Pages.Statement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Bushuev.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="792"
      Title="Statement">
    <Grid Background="#F8F9FA">
        <Grid Margin="0, 0, 0, 349.6" Background="White">
            <Image
                HorizontalAlignment="Left" Height="40" Margin="10, 10, 0, 0"
                VerticalAlignment="Top" Width="40" Source="/Pages/logo.png"
            />
            <Label Content="Электронная приемная компания" HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="60, 0, 0, 0" FontWeight="Bold" FontSize="19"/>
            <Label Content="Пермского авиационного техникума им. А.Д. Щвецова" VerticalAlignment="Top" 
                   Margin="60, 25, 0, 0"/>
        </Grid>
        <Grid Margin="0, 60, 0, 0">
            <Label Content="Заявление" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                   FontWeight="Bold"/>
            <Label Content="Прошу принять меня КГАПОУ Пермский авиационный техникум им. А.Д. Щвецова" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 40, 0, 0"
                   />
            <Label Content="Выберите один из вариантов" 
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="20, 65, 0, 0"
                   FontSize="10"
                   Foreground="red"
                   />
            <CheckBox
                Content="по очной форме обучения"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 90, 0, 0"
                />
            <CheckBox
                Content="по заочной форме обучения (обучение только на платной основе)"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 105, 0, 0"
                />
            <Label Content="Выберите один из вариантов" 
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="20, 125, 0, 0"
               FontSize="10"
               Foreground="red"
               />
            <CheckBox
                Content="за счет бюджета"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 165, 0, 0"
                />
            <CheckBox
                Content="по договору (платно)"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20, 150, 0, 0"
                />
            <Label
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Content="О себе сообщаю следующее:"
                Margin="10, 185, 0, 0"
                />
            <Label
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Content="Окончил (Наименование образовательной организации, город)"
                Margin="10, 210, 0, 0"
                />
            <TextBox
                Height="24"
                Margin="10, 235, 10, 0"
                TextWrapping="Wrap"
                VerticalAlignment="Top"
                />
            <Label
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Content="Год окончания образовательной организации"
                Margin="10, 265, 0, 0"
                />
            <TextBox
                Height="24"
                Margin="10, 290, 10, 0"
                TextWrapping="Wrap"
                VerticalAlignment="Top"
                />
            <Button
                Content="Продолжить"
                HorizontalAlignment="Right"
                Margin="0, 0, 10, 5"
                VerticalAlignment="Bottom"
                Width="150"
                Height="25"
                />
        </Grid>
    </Grid>
</Page>
