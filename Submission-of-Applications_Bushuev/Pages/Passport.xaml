<Page x:Class="Submission_of_Applications_Bushuev.Pages.Passport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Bushuev.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="792"
      Title="Passport">
    <Grid Background="#F8F9FA">
        <Grid Margin="0, 0, 0, 349.6" Background="White">
            <Image
            HorizontalAlignment="Left" Height="40" Margin="10, 10, 0, 0"
            VerticalAlignment="Top" Width="40" Source="/Images/logo.png"
            />
            <Label Content="Электронная приемная компания" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="60, 0, 0, 0" FontWeight="Bold" FontSize="19"/>
            <Label Content="Пермского авиационного техникума им. А.Д. Щвецова" VerticalAlignment="Top" 
           Margin="60, 25, 0, 0"/>
        </Grid>
        <ScrollViewer VerticalContentAlignment="Top" Margin="0, 60, 0, 0">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Паспортные данные:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                       FontWeight="Bold"/>
                <Label Content="Фамилия:" 
                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 40, 0, 0"
                       />
                <Label Content="Имя:"
                       HorizontalAlignment="Left" VerticalAlignment="Top" 
                       Margin="10, 40, 0, 0" Grid.Column="1"
                       />
                <Label Content="Отчество:"
                   HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Margin="10, 40, 0, 0" Grid.Column="2"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 65, 10, 0 " Grid.Column="0"
                    TextWrapping="Wrap"
                    />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 65, 10, 0 " Grid.Column="1"
                    TextWrapping="Wrap"
                    />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 65, 10, 0 " Grid.Column="2"
                    TextWrapping="Wrap"
                    />
                <Label Content="Дата рождения:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 90, 0, 0"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 115, 10, 0 " Grid.ColumnSpan="3"
                    TextWrapping="Wrap"
                    />
                <Label Content="Гражданство:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 140, 0, 0"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 165, 10, 0 " Grid.ColumnSpan="3"
                    TextWrapping="Wrap"
                    />
                <Label Content="Место рождения:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 190, 0, 0"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 215, 10, 0 " Grid.ColumnSpan="3"
                    TextWrapping="Wrap"
                    />
                <Label Content="Серия и номер паспорта:" 
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 240, 0, 0"
                    />
                <Label Content="Дата выдачи:"
                   HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Margin="10, 240, 0, 0" Grid.Column="1"
                   />
                <Label Content="Код подразделения:"
                   HorizontalAlignment="Left" VerticalAlignment="Top" 
                   Margin="10, 240, 0, 0" Grid.Column="2"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 265, 10, 0 " Grid.Column="0"
                    TextWrapping="Wrap"
                    />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 265, 10, 0 " Grid.Column="1"
                    TextWrapping="Wrap"
                    />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 265, 10, 0 " Grid.Column="2"
                    TextWrapping="Wrap"
                    />
                <Label Content="Кем выдан:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 290, 0, 0"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 315, 10, 0 " Grid.ColumnSpan="3"
                    TextWrapping="Wrap"
                    />
                <Label Content="Адрес по прописке:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 340, 0, 0"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 365, 10, 0 " Grid.ColumnSpan="2"
                    TextWrapping="Wrap"
                    />
                <Label Content="Район:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 340, 0, 0"
                   Grid.Column="2"
                   />
                <Label Content="Район:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 390, 0, 0"
                   Grid.Column="2"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 365, 10, 0 " Grid.Column="2"
                    TextWrapping="Wrap"
                    />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 415, 10, 0 " Grid.Column="2"
                    TextWrapping="Wrap"
                    />
                <Label Content="Адрес проживания фактический:" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 390, 0, 0"
                   />
                <TextBox
                    VerticalAlignment="Top"
                    Height="24" Margin="10, 415, 10, 0 " Grid.ColumnSpan="2"
                    TextWrapping="Wrap"
                    />
                <Label
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Content="Прикрепите сканы страниц паспорта с фотографией и действующей пропиской"
                    Margin="10, 440, 0, 0" Grid.ColumnSpan="3"
                />
                <Label Content="(Формат документов должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ)" 
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="20, 465, 0, 0"
                   FontSize="10"
                   Foreground="red" Grid.ColumnSpan="2"
                   />
                <TextBox
                    Height="24"
                    Margin="20,490,115,0"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" Grid.ColumnSpan="3"
                />
                <Button
                    Content="Выбрать ..."
                    HorizontalAlignment="Right"
                    Margin="0,490,10,0"
                    VerticalAlignment="Top"
                    Width="100"
                    Height="24" Grid.Column="2"
                />
                <Button
                    Content="Продолжить"
                    HorizontalAlignment="Right"
                    Margin="0, 0, 10, 5"
                    VerticalAlignment="Bottom"
                    Width="150"
                    Height="25" Grid.Column="2"
                    Click="Button_Click"
                />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
