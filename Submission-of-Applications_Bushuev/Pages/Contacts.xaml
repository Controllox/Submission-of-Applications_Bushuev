<Page x:Class="Submission_of_Applications_Bushuev.Pages.Contacts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Bushuev.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="792"
      Title="Contacts">
    <Grid Background="#F8F9FA">
        <Grid Margin="0, 0, 0, 349.6" Background="White">
            <Image
            HorizontalAlignment="Left" Height="40" Margin="10, 10, 0, 0"
            VerticalAlignment="Top" Width="40" Source="/Images/logo.png"
            />
            <Label Content="Электронная приемная компания" HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="60, 0, 0, 0" FontWeight="Bold" FontSize="19"/>
            <Label Content="Пермского авиационного техникума им. А.Д. Щвецова" VerticalAlignment="Top" 
           Margin="60, 25, 0, 0"/>
        </Grid>
        <ScrollViewer VerticalContentAlignment="Top" Margin="0, 60, 0, 0">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Контакты" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                    FontWeight="Bold"/>
                <Label Content="Домашний номер:" 
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 40, 0, 0"
                    />
                <Label Content="Мобильный номер:" 
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 40, 0, 0"
                    Grid.Column="1"
                    />
                <TextBox
                    Height="24"
                    Margin="10,65,10,0"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" Grid.Column="0"
                    />
                <TextBox
                    Height="24"
                    Margin="10,65,10,0"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" Grid.Column="1"
                    />
                <Label Content="Мобильный номер:" 
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10, 90, 0, 0"
                    />
                <TextBox
                    Height="24"
                    Margin="10,115,10,0"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" Grid.ColumnSpan="2"
                    />
                <Button
                    Content="Продолжить"
                    HorizontalAlignment="Right"
                    Margin="0, 0, 10, 5"
                    VerticalAlignment="Bottom"
                    Width="150"
                    Height="25" Grid.Column="1"
                />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
